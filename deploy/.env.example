# 앱 서버 2대 각각의 ~/.env 에 아래 변수를 채운다 (값은 절대 커밋하지 않는다).
# docker-compose.dev.yml 의 backend 서비스에 `env_file: .env` 를 추가해야 컨테이너로 들어간다.
# 운영 이미지에는 비밀값이 들어 있지 않으므로, 여기서 빠진 값은 기동 실패나 기능 오류로 이어진다.

# --- 공통 인프라 ---
SPRING_KAFKA_BOOTSTRAP_SERVERS=
SPRING_DATA_REDIS_HOST=

# --- DB ---
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# --- 인증 (JWT) ---
JWT_SECRET=
ACCESS_TOKEN_VALIDATING_SECONDS=
REFRESH_TOKEN_VALIDATING_SECONDS=

# --- 소셜 로그인 (Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 메일 (비우면 localhost:2525 기본값으로 떠서 메일이 나가지 않음) ---
MAIL_TEST_HOST=
MAIL_TEST_PORT=
MAIL_TEST_USERNAME=
MAIL_TEST_PASSWORD=

# --- S3 ---
BUCKET=
STATIC=
ACCESS_KEY=
SECRET_KEY=

# --- OpenAI (챗봇) ---
OPENAI_BASE_URL=
OPENAI_SECRET_KEY=
MODEL=

# --- Slack (DLQ 알림) ---
SLACK_WEB_HOOK=

# --- 웹 푸시 (VAPID). 키를 바꾸면 기존 브라우저 구독은 다시 구독해야 한다 ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
