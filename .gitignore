# Gradle 설정 디렉토리
.gradle/
gradle/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
gradle.properties
# Gradle 빌드 결과물
build/
!**/src/main/**/build/
!**/src/test/**/build/
out/
.idea/

# Gradle 스크립트 파일 (전체 무시 대신 예외 허용)
*.gradle
!**/build.gradle
**/out/
**/out/**/*
*.class
**/build/
*.log
*.hprof

# 환경 설정 파일
.env
*.properties
**/out/production/
**/out/production/classes/
# YML 설정파일
*.yml
**.yml
# CI에서 테스트 실행 시 필요한 프로필 설정 - 실제 운영 시크릿은 넣지 말 것
!bootstrap/src/test/resources/application-test.yml
# CI에서 운영 이미지를 빌드하려면 필요한 설정 - 비밀값은 전부 ${ENV}로만 읽는다 (값은 서버 .env)
!bootstrap/src/main/resources/application-prod.yml
!domain/member/connector/out-bound/src/main/resources/application-oauth2.yml
!domain/notification/connector/in-bound/src/main/resources/application-slack.yml
!domain/notification/connector/out-bound/api-client/src/main/resources/application-push.yml
*.env
# STS 관련
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

# VSCode
.vscode/

# IntelliJ 관련
.idea/
*.iws
*.iml
*.ipr
*.xml

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle

